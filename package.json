{
  "name": "@fansionia/openclaw-qqbot-snowluma",
  "version": "0.1.4",
  "description": "Natural QQ conversations for OpenClaw through SnowLuma OneBot v11",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs/protocol.md",
    "docs/chat-style.md",
    "docs/validation.md",
    "examples/openclaw.json",
    "examples/rion"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@snowluma/sdk": "2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.2",
    "openclaw": "2026.11.2",
    "typescript": "7.0.2",
    "vite-plus": "1.5.1",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "openclaw": "2026.11.2"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.18.0",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "qq-snowluma",
      "label": "SnowLuma QQ"
    }
  }
}
